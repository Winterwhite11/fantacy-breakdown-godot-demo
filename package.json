{
  "name": "fantacy-breakdown-demo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Fantacy Breakdown —— 咏唱制卡牌搜打撤 Demo（HTML 验证床）",
  "scripts": {
    "check": "node tools/stamp.mjs && node tools/validate.mjs",
    "test": "node tools/validate.mjs && node tools/ui-wiring.mjs && node tools/preview-test.mjs && node tools/pieces-test.mjs && node tools/equip-test.mjs && node tools/oneclick-test.mjs && node tools/summon-test.mjs && node tools/frost-test.mjs && node tools/poison-test.mjs && node tools/market-test.mjs",
    "test:frost": "node tools/frost-test.mjs",
    "test:poison": "node tools/poison-test.mjs",
    "test:preview": "node tools/preview-test.mjs",
    "test:oneclick": "node tools/oneclick-test.mjs",
    "test:equip": "node tools/equip-test.mjs",
    "test:ui": "node tools/ui-wiring.mjs",
    "test:pieces": "node tools/pieces-test.mjs",
    "test:summon": "node tools/summon-test.mjs",
    "test:market": "node tools/market-test.mjs",
    "economy": "node tools/economy-test.mjs --runs 400",
    "economy:calibrate": "node tools/economy-calibrate.mjs",
    "economy:solve": "node tools/economy-solve.mjs",
    "recipes": "python tools/themed-equip-recipes.py",
    "art": "node tools/art-direction.mjs",
    "art:check": "node tools/art-direction.mjs --check",
    "icons": "node html-demo/tools/gen_equip_icons.cjs",
    "stamp": "node tools/stamp.mjs",
    "validate": "node tools/validate.mjs",
    "balance": "node tools/balance.mjs --games 300",
    "balance:quick": "node tools/balance.mjs --games 120",
    "archive": "node tools/archive_snapshot.mjs",
    "prices": "node html-demo/tools/gen_price_table.cjs",
    "cards": "python html-demo/tools/parse_card_table_docx_v2.py",
    "serve": "python -m http.server 8765",
    "precommit": "node tools/stamp.mjs && node tools/validate.mjs"
  },
  "notes": {
    "no-dependencies": "本仓库刻意不引入任何 npm 依赖。所有脚本只用 Node 内置模块，避免给这个静态 Demo 增加构建负担。",
    "workflow": "改动流程：npm run archive <标签> → 改代码 → npm run check → npm run balance → git commit"
  }
}
